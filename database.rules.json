{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[0-9]{4}$/)"
      }
    },
    "ws": {
      ".read": "auth != null",
      "config": {
        ".write": "auth != null && auth.token.email == 'goraniduck@gmail.com'"
      },
      "subs": {
        "$n": {
          ".validate": "$n.matches(/^([1-9]|1[0-9]|2[0-5])$/)",
          "$s": {
            ".validate": "$s.matches(/^([1-9]|1[0-9]|2[0-5])$/) && newData.hasChildren(['a','at'])",
            ".write": "auth != null && (auth.token.email == 'goraniduck@gmail.com' || (!data.exists() && newData.exists()))"
          }
        }
      },
      "fb": {
        ".write": "auth != null && auth.token.email == 'goraniduck@gmail.com'"
      },
      "hist": {
        ".write": "auth != null && auth.token.email == 'goraniduck@gmail.com'"
      },
      "seen": {
        "$n": {
          ".validate": "$n.matches(/^([1-9]|1[0-9]|2[0-5])$/)",
          "$s": {
            ".validate": "newData.isNumber()",
            ".write": "auth != null"
          }
        }
      }
    },
    "maeul": {
      "classes": {
        ".read": "auth != null",
        "$c": {
          ".write": "auth != null && (newData.exists() || auth.token.email == 'goraniduck@gmail.com')",
          ".validate": "$c.matches(/^[3-6]-([1-9]|1[0-9]|20)$/) && newData.isBoolean()"
        }
      },
      "posts": {
        ".read": "auth != null && auth.token.email == 'goraniduck@gmail.com'",
        "$c": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'goraniduck@gmail.com'",
          ".validate": "$c.matches(/^[3-6]-([1-9]|1[0-9]|20)$/)",
          "$p": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['uid','team','sid','solution','at']) && newData.child('team').isString() && newData.child('team').val().length <= 40 && newData.child('solution').isString() && newData.child('solution').val().length <= 2000 && (!newData.child('drawing').exists() || (newData.child('drawing').isString() && newData.child('drawing').val().length <= 300000))"
          }
        }
      },
      "likes": {
        ".read": "auth != null && auth.token.email == 'goraniduck@gmail.com'",
        "$c": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.email == 'goraniduck@gmail.com'",
          "$p": {
            "$u": {
              ".write": "auth != null && $u == auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    }
  }
}
